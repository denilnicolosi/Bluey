# Environment configuration for Bluey LangGraph

# API KEY LLM provider configuration
OPENAI_API_KEY=...
GEMINI_API_KEY=...
NVIDIA_API_KEY=...

# LLM Models Configuration
EMAIL_AGENT_MODEL=openai:gpt-5-nano
APPOINTMENT_AGENT_MODEL=openai:gpt-5-nano
DOCUMENTATION_AGENT_MODEL=openai:gpt-5-nano
SUPERVISOR_AGENT_MODEL= openai:gpt-5-mini
SQL_AGENT_MODEL=openai:gpt-5-mini

# LangSmith Configuration
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=bluey
LANGSMITH_TRACING=true
# Tags every trace so demo / eval / dev runs stay separable inside one project
BLUEY_ENV=dev
# Centralise prompts on LangSmith Prompt Hub. false = use the literals in prompts.py.
# Seed the hosted prompts once with: python evaluate/push_prompts.py
LANGSMITH_PROMPTS=false
# Optional commit tag/hash to pin prompts for reproducible eval; empty = latest commit
LANGSMITH_PROMPT_TAG=

# Logging
LOG_LEVEL=INFO

# File Paths
DOCS_PATH=./docs
OUTPUT_DIR=./outputs/
GOOGLE_CREDENTIALS_DIR=./google_credentials
DATABASE_PATH=./data/insurance.db

# Google Workspace
GOOGLE_EMAIL_SENDER=your.address@gmail.com
GOOGLE_CALENDAR_ID=primary
# IANA Time Zone Database name, as required by the Calendar API EventDateTime.timeZone field
GOOGLE_CALENDAR_TIMEZONE=Europe/Rome
