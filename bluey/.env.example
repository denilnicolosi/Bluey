# Environment configuration for Bluey LangGraph

# API KEY LLM provider configuration
OPENAI_API_KEY=...
GEMINI_API_KEY=...
NVIDIA_API_KEY=...

# LLM Models Configuration
EMAIL_AGENT_MODEL=openai:gpt-5-nano
APPOINTMENT_AGENT_MODEL=openai:gpt-5-nano
DOCUMENTATION_AGENT_MODEL=openai:gpt-5-nano
SUPERVISOR_AGENT_MODEL= openai:gpt-5-mini
SQL_AGENT_MODEL=openai:gpt-5-mini

# LangSmith Configuration
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=bluey
LANGSMITH_TRACING=true

# Logging
LOG_LEVEL=INFO

# File Paths
DOCS_PATH=./docs
OUTPUT_DIR=./outputs/
GOOGLE_CREDENTIALS_DIR=./google_credentials
DATABASE_PATH=./data/insurance.db
